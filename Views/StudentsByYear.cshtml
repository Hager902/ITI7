@model List<Student>
@{
    ViewData["Title"] = $"Year {ViewData["Year"]} Students";
}


<div class="container mt-4">
    <h2>Year @ViewData["Year"] Students</h2>
    
    @if (Model.Count > 0)
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Full Name</th>
                    <th>GPA</th>
                    <th>Email</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.FullName</td>
                        <td>@student.Gpa.ToString("F2")</td>
                        <td>@student.Email</td>
                        <td><a href="/students/details/@student.Id" class="btn btn-sm btn-primary">View</a></td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <p>No students found for year @ViewData["Year"].</p>
    }
    
    <a href="/students/roster" class="btn btn-secondary mt-3">Back to Roster</a>
</div>
