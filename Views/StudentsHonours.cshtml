@model IEnumerable<StudentPortalWeb.Models.Student>

@{
    ViewData["Title"] = "Honours Students";
}

<h2>Honours Students</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Year</th>
            <th>GPA</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <partial name="_StudentRow" model="student" />
        }
    </tbody>
</table>