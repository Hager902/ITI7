@model List<StudentPortalWeb.Models.Student>

@{
    ViewData["Title"] = "Student Portal";
} 

<div class="text-center">

<h1>THIS IS THE STUDENTS PAGE</h1>

<p>Count = @(Model?.Count ?? 0)</p>
    
    <p style="margin-top: 20px; font-size: 18px; background-color: #f0f0f0; padding: 15px; border-radius: 5px;">
        <strong>Owner:</strong> @ViewBag.Owner | 
        <strong>Stamp A:</strong> @ViewBag.StampA | 
        <strong>Stamp B:</strong> @ViewBag.StampB
    </p>
</div>

<div style="margin-top: 30px;">
    <h2>Student Roster</h2>
    
    @if (Model != null && Model.Count > 0)
    {
        <table class="table table-striped table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Full Name</th>
                    <th>Year of Study</th>
                    <th>GPA</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var student in Model)
                {
                    <tr>
                        <td>@student.FullName</td>
                        <td>@student.YearOfStudy</td>
                        <td>@student.Gpa.ToString("F2")</td>
                    </tr>
                }
            </tbody>
        </table>
        
        <p style="margin-top: 20px; color: #666;">
            Total Students: <strong>@Model.Count</strong>
        </p>
    }
    else
    {
        <div class="alert alert-warning">No students found in the database.</div>
    }
</div>