@model IEnumerable<StudentPortalWeb.Models.Student>

@{
    ViewData["Title"] = "Students by Year";
}

<h2>Students by Year</h2>

<table class="table table-striped">
    <thead>
        <tr>
            <th>Name</th>
            <th>Year</th>
            <th>GPA</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model)
        {
            <partial name="_StudentRow" model="student" />
        }
    </tbody>
</table>

//Error: The partial view StudentRow requires a model of type Student, but null was passed
//ASP.NET passes nothing null so the partial can't access Model.FullName or Model.YearOfStudy 